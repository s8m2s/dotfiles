# Ghostty config
# Managed by chezmoi: edit, then `chezmoi re-add` and commit.
# Reload in Ghostty: Cmd+Shift+,  ·  All options: https://ghostty.org/docs/config

# ── Font ─────────────────────────────────────────────────────
font-size = 18
adjust-cell-height = 15%

# ── Window ───────────────────────────────────────────────────
window-padding-x = 6
window-padding-y = 2
window-padding-balance = true

# ── macOS ────────────────────────────────────────────────────
macos-titlebar-style = tabs
macos-option-as-alt = true
